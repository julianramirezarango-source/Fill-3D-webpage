{
  "name": "fill3d-content",
  "version": "1.0.0",
  "description": "Content creation tools for Fill-3D: videos (Remotion), images (Nano Banana), and research (AutoResearch)",
  "main": "index.js",
  "scripts": {
    "studio": "remotion studio src/videos/Root.tsx",
    "render:intro": "remotion render src/videos/Root.tsx Fill3DIntro out/intro.mp4",
    "render:showcase": "remotion render src/videos/Root.tsx ProductShowcase out/showcase.mp4",
    "render:all": "npm run render:intro && npm run render:showcase",
    "images": "ts-node src/images/generate.ts",
    "images:hero": "ts-node src/images/generate.ts hero",
    "research": "autoresearch run --config src/research/config.ts"
  },
  "keywords": [
    "content",
    "fill3d",
    "remotion",
    "video",
    "3d-printing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@remotion/cli": "^4.0.438",
    "@remotion/player": "^4.0.438",
    "autoresearch": "^0.0.1",
    "remotion": "^4.0.438"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
