# Página principal: buscar index.html primero
DirectoryIndex index.html index.php

Options -Indexes

# Tipos MIME correctos para los assets de Next.js
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /wiki/calculadora/

# Servir archivos existentes directamente (CSS, JS, imágenes, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Servir directorios existentes directamente
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback: cualquier ruta desconocida → index.html
RewriteRule ^ index.html [L]
</IfModule>
